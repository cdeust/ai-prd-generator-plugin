{
  "name": "ai-prd-generator",
  "description": "Enterprise PRD generator with 8 PRD types, 15 thinking strategies, multi-judge verification, codebase analysis, and 9-file export",
  "version": "1.0.0",
  "author": {
    "name": "Clement Deust",
    "email": "admin@ai-architect.tools"
  },
  "homepage": "https://ai-architect.tools",
  "repository": "https://github.com/cdeust/ai-prd-generator-plugin",
  "license": "Commercial",
  "keywords": ["prd", "product-requirements", "documentation", "enterprise", "verification"],
  "mcpServers": {
    "ai-prd-tools": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-server/index.js"],
      "env": {
        "AIPRD_SKILL_CONFIG": "${CLAUDE_PLUGIN_ROOT}/skills/ai-prd-generator/skill-config.json"
      }
    }
  }
}
